# Copy to .env for local `netlify dev`. In production, set these in
# Netlify > Site configuration > Environment variables. Never commit real keys.

# --- Claude API (optional, server-side only) ---
# Leave AI_ENABLED unset or "false" to run with no AI at all.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Model used by netlify/functions/ai.mjs. Default: claude-opus-5-5.
# For lower cost you can set claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5
# Per-IP request cap per hour for the AI route (best effort, per function instance).
AI_HOURLY_LIMIT=20

# --- Translation (planned, not active) ---
# TRANSLATION_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=

# --- Supabase (planned, not active) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=   # publishable anon key only; never the service role key
